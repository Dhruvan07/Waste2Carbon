# ==============================================================================
# CarbonCycle Frontend Environment Variables (.env.example)
# ==============================================================================
#
# Vite requires all client-exposed variables to be prefixed with `VITE_`.
#
# VITE_API_URL:
# The root URL of your deployed Render backend or local Express server.
#
# Examples:
# For Deployed Render Backend:
#   VITE_API_URL=https://carbon-cycle-api.onrender.com
#
# For Local Development:
#   VITE_API_URL=http://localhost:5000
#
VITE_API_URL=https://carbon-cycle-api.onrender.com
